FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Jenkins Job Builder (3.11.0 for compatibility)
RUN pip3 install jenkins-job-builder==3.11.0

# Create working directory
WORKDIR /jjb

# Set entrypoint
ENTRYPOINT ["jenkins-jobs"]
